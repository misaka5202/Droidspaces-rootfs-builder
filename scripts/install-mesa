#!/bin/bash
# Install mesa-for-android-container (Adreno / Snapdragon) into the rootfs.
# Ubuntu 22.04 (jammy) has no official package; fall back to noble tarball.
# No jq required — parse GitHub API JSON with grep.
set -euo pipefail

REPO="lfdevs/mesa-for-android-container"
API="https://api.github.com/repos/${REPO}"
AUTH_HEADER=()
if [ -n "${GITHUB_TOKEN:-}" ]; then
  AUTH_HEADER=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
fi

echo "--> [mesa] resolving download URL..."

# Extract first browser_download_url whose filename matches the given arch suffix.
pick_url() {
  local json="$1"
  local suffix="$2"
  printf '%s' "$json" \
    | grep -oE "https://[^\"]+/mesa-for-android-container_[^\"]*_${suffix}\\.tar\\.gz" \
    | head -1
}

has_assets() {
  local json="$1"
  [ -n "$json" ] && printf '%s' "$json" | grep -q 'browser_download_url'
}

URL=""
LATEST=""
LIST=""

LATEST=$(curl -fsSL "${AUTH_HEADER[@]}" "${API}/releases/latest" 2>/dev/null || true)
if has_assets "$LATEST"; then
  URL=$(pick_url "$LATEST" "ubuntu_jammy_arm64")
  if [ -z "$URL" ]; then
    URL=$(pick_url "$LATEST" "ubuntu_noble_arm64")
  fi
fi

if [ -z "$URL" ]; then
  echo "--> [mesa] scanning recent releases..."
  LIST=$(curl -fsSL "${AUTH_HEADER[@]}" "${API}/releases?per_page=30" 2>/dev/null || true)
  if has_assets "$LIST"; then
    URL=$(pick_url "$LIST" "ubuntu_jammy_arm64")
    if [ -z "$URL" ]; then
      URL=$(pick_url "$LIST" "ubuntu_noble_arm64")
    fi
  fi
fi

download_ok=0
if [ -n "$URL" ]; then
  echo "--> [mesa] downloading: $URL"
  if curl -fL --retry 5 --retry-delay 3 -o /tmp/mesa.tar.gz "$URL"; then
    download_ok=1
  else
    echo "--> [mesa] download failed for API URL, trying fallbacks..."
  fi
fi

if [ "$download_ok" -ne 1 ]; then
  echo "--> [mesa] trying known noble release assets..."
  CANDIDATES=(
    "https://github.com/lfdevs/mesa-for-android-container/releases/download/mesa-26.2.0-devel-20260709/mesa-for-android-container_26.2.0-devel-20260709_ubuntu_noble_arm64.tar.gz"
    "https://github.com/lfdevs/mesa-for-android-container/releases/download/mesa-26.2.0-devel-20260621/mesa-for-android-container_26.2.0-devel-20260621_ubuntu_noble_arm64.tar.gz"
    "https://github.com/lfdevs/mesa-for-android-container/releases/download/mesa-26.2.0-devel-20260610/mesa-for-android-container_26.2.0-devel-20260610_ubuntu_noble_arm64.tar.gz"
  )
  for c in "${CANDIDATES[@]}"; do
    echo "--> [mesa] fallback: $c"
    if curl -fL --retry 3 --retry-delay 2 -o /tmp/mesa.tar.gz "$c"; then
      download_ok=1
      URL="$c"
      break
    fi
  done
fi

if [ "$download_ok" -ne 1 ]; then
  echo "--> [mesa] ERROR: could not download mesa tarball."
  echo "--> [mesa] Tip: pass GITHUB_TOKEN to avoid API rate limits."
  exit 1
fi

echo "--> [mesa] extracting..."
tar -zxf /tmp/mesa.tar.gz -C /
rm -f /tmp/mesa.tar.gz
ldconfig
echo "--> [mesa] installed OK from: $URL"
